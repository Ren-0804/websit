  "narrative": {
    "northStar": "航运企业识别手册",
    "overview": "用户于 2026-10-21 选定品牌蓝配物流大图、稳重熟悉的企业官网。系统以清晰的双语层级、宽幅实景、水平目录与轻圆角字段组织内容。公开页面兼顾询价与资料查阅；后台使用同一视觉语言，减少装饰并保留操作密度。",
    "keyCharacteristics": [
      "品牌蓝、纸白、浅冰蓝与深海军蓝。",
      "物流摄影用于展示场景，不能作为公司自有设施、运力或客户案例的证明。",
      "导航、服务目录、表单与阅读页面共享排版和交互规则。"
    ],
    "rules": [
      "首页中文标题按原文逗号分段，字号 clamp(1.5rem, 7vw, 3.9rem)，保留完整语义。",
      "内页标题区使用 32px/40px 上下留白，紧随的首个内容区使用 32–48px。",
      "手机联系页优先显示电话和邮件快捷入口及货物表单，完整联系方式随后展示。",
      "完整表单用 * 标示必填并解释含义；手机文章目录在正文前折叠展示。"
    ],
    "dos": [
      "Do 保留真实服务、目的地、公司信息及现有品牌标志。",
      "Do 为官网、资料和后台选择各自适合的内容密度。",
      "Do 用语义结构、文字与可见状态共同解释交互。"
    ],
    "donts": [
      "Don't 把物流图片包装为未经证实的公司设施或运输案例。",
      "Don't 用新数据、时效、运价、客户或资质填补视觉空间。",
      "Don't 混用旧米白红色风格、渐变按钮或装饰性网格。"
    ]
  }
