      "html": "<label class=\"ds-label\">目的地<input class=\"ds-field\" placeholder=\"例如：塔什干\"></label>",
      "css": ".ds-label{display:block;color:hsl(var(--foreground));font:600 14px/1.5 sans-serif}.ds-field{display:block;box-sizing:border-box;width:100%;margin-top:8px;padding:12px 16px;border:1px solid hsl(var(--input));border-radius:10px;background:white;color:hsl(var(--foreground));font:400 16px/1.5 sans-serif;caret-color:hsl(var(--primary))}.ds-field::placeholder{color:#60728c;opacity:1}.ds-field:focus-visible{border-color:hsl(var(--primary));outline:2px solid hsl(var(--ring));outline-offset:4px}"
