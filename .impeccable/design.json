      "html": "<nav class=\"ds-nav\"><a href=\"#\" aria-current=\"page\">服务范围</a><a href=\"#\">线路区域</a><a href=\"#\">业务笔记</a></nav>",
      "css": ".ds-nav{display:flex;gap:24px;flex-wrap:wrap;background:white;border-bottom:1px solid hsl(var(--border));font:500 14px/1.5 sans-serif}.ds-nav a{display:block;padding:20px 0;color:hsl(var(--muted-foreground));text-decoration:none;border-bottom:2px solid transparent}.ds-nav a[aria-current]{color:hsl(var(--primary));border-color:hsl(var(--primary))}.ds-nav a:hover{color:hsl(var(--primary))}.ds-nav a:focus-visible{outline:2px solid hsl(var(--ring));outline-offset:4px}"
