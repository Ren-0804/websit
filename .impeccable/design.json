  "narrative": {
    "northStar": "航运企业识别手册",
    "overview": "用户选定品牌蓝配物流大图、稳重熟悉的企业官网。2026-10-22 根据用户对旧截图的反馈重建首页构图：铁路全景承担第一视觉，询价位于主画面之后，服务入口使用统一运输摄影。公开页面兼顾询价与资料查阅；阅读和后台页面保留操作密度。",
    "keyCharacteristics": [
      "品牌蓝、纸白与深海军蓝交替形成页面层次。",
      "宽幅铁路主视觉、摄影服务入口与可筛选目的地构成核心阅读顺序。",
      "AI 生成图为场景示意，始终披露来源，不证明公司设施或运力。",
      "中英文共享组件，按文字长度调整排版与移动端高度。"
    ],
    "rules": [
      {
        "name": "The Photography Contrast Rule",
        "body": "主视觉遮罩由左侧 rgb(4 24 48 / 88%) 过渡到右侧 12%，手机由 85% 过渡到 35%；以文字可读和列车辨识为准。暗色区正文采用浅蓝白，焦点环采用浅蓝。",
        "section": "colors"
      },
      {
        "name": "The Display Rule",
        "body": "首页主张为两行完整语义，使用 display token；英文最大宽 19ch。摄影内页标题为 clamp(2rem, 3.7vw, 3.5rem)，手机 32px。文章长标题使用独立阅读排版，不套首页主张字号。",
        "section": "typography"
      },
      {
        "name": "The Flat Surface Rule",
        "body": "常规内容依靠深浅色区、边界和摄影构图分层，不叠加卡片阴影。主视觉只保留文字所需遮罩；抽屉沿用 Radix 对话框遮罩、焦点约束和层级。",
        "section": "elevation"
      }
    ],
    "dos": [
      "Do 保留真实服务、目的地、公司信息及现有品牌标志。",
      "Do 为官网、资料和后台选择各自适合的内容密度。",
      "Do 用语义结构、文字与可见状态共同解释交互。"
    ],
    "donts": [
      "Don't 把生成图片包装为公司自有设施、车队或运输案例。",
      "Don't 用未经确认的时效、运价、客户数或资质填补视觉空间。",
      "Don't 恢复遮挡主画面的巨型询价卡、服务纯目录或装饰性阴影。"
    ]
  }
}
